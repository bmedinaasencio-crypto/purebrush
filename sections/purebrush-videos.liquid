{% comment %}
  Section: Pure Brush Product Videos / Video Showcase
  Modern interactive video gallery supporting both native MP4 and YouTube Shorts/Videos
{% endcomment %}

<section id="videos-producto" class="purebrush-videos-section" style="background-color: {{ section.settings.bg_color | default: '#ffffff' }};">
  <div class="purebrush-videos-container">
    <div class="purebrush-videos-header">
      {% if section.settings.badge != blank %}
        <span class="sub-badge">{{ section.settings.badge }}</span>
      {% endif %}
      <h2 class="section-title">{{ section.settings.heading }}</h2>
      {% if section.settings.subheading != blank %}
        <p class="section-desc">{{ section.settings.subheading }}</p>
      {% endif %}
    </div>

    <!-- Video Grid (Estilo Reels / Demostración Real) -->
    <div class="purebrush-video-grid">
      {% for block in section.blocks %}
        {% assign is_mp4 = false %}
        {% assign video_src = block.settings.mp4_url %}
        {% if video_src != blank and video_src contains '.mp4' %}
          {% assign is_mp4 = true %}
        {% endif %}

        {% assign yt_id = '' %}
        {% assign is_short = false %}
        {% if block.settings.video_url contains 'youtube.com/shorts/' %}
          {% assign yt_id = block.settings.video_url | split: 'shorts/' | last | split: '?' | first %}
          {% assign is_short = true %}
        {% elsif block.settings.video_url contains 'youtube.com/watch?v=' %}
          {% assign yt_id = block.settings.video_url | split: 'v=' | last | split: '&' | first %}
        {% elsif block.settings.video_url contains 'youtu.be/' %}
          {% assign yt_id = block.settings.video_url | split: 'youtu.be/' | last | split: '?' | first %}
        {% endif %}

        {% assign poster_url = block.settings.custom_poster %}
        {% if poster_url == blank and yt_id != blank %}
          {% assign poster_url = 'https://i.ytimg.com/vi/' | append: yt_id | append: '/hqdefault.jpg' %}
        {% endif %}

        <div class="purebrush-video-card" {{ block.shopify_attributes }}>
          <div 
            class="video-thumbnail-wrapper {% if is_short %}aspect-vertical{% else %}aspect-standard{% endif %}"
            onclick="purebrushLaunchVideo({
              isMp4: {{ is_mp4 }},
              mp4Url: '{{ video_src | escape }}',
              ytId: '{{ yt_id }}',
              isShort: {{ is_short }},
              title: '{{ block.settings.title | escape }}'
            })"
          >
            {% if is_mp4 %}
              <video 
                class="video-preview-native" 
                muted 
                loop 
                playsinline 
                preload="metadata"
                onmouseover="this.play()" 
                onmouseout="this.pause()"
                poster="{{ poster_url }}"
              >
                <source src="{{ video_src }}" type="video/mp4">
              </video>
            {% elsif poster_url != blank %}
              <img 
                src="{{ poster_url }}" 
                alt="{{ block.settings.title | escape }}" 
                class="video-thumbnail-img"
                loading="lazy"
                width="480"
                height="640"
              >
            {% else %}
              <div class="video-placeholder-gradient"></div>
            {% endif %}

            <div class="video-card-overlay">
              <div class="play-pulse-btn" aria-label="Reproducir vídeo">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M8 5v14l11-7z"/>
                </svg>
              </div>
            </div>

            {% if block.settings.tag != blank %}
              <span class="video-tag">{{ block.settings.tag }}</span>
            {% endif %}

            {% if block.settings.duration != blank %}
              <span class="video-duration">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                {{ block.settings.duration }}
              </span>
            {% endif %}
          </div>

          <div class="video-card-info">
            <h3 class="video-card-title">{{ block.settings.title }}</h3>
            {% if block.settings.caption != blank %}
              <p class="video-card-caption">{{ block.settings.caption }}</p>
            {% endif %}
            <button 
              type="button" 
              class="video-text-link" 
              onclick="purebrushLaunchVideo({
                isMp4: {{ is_mp4 }},
                mp4Url: '{{ video_src | escape }}',
                ytId: '{{ yt_id }}',
                isShort: {{ is_short }},
                title: '{{ block.settings.title | escape }}'
              })"
            >
              <span>Ver vídeo en acción</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </button>
          </div>
        </div>
      {% endfor %}
    </div>

    {% if section.settings.cta_text != blank %}
      <div class="purebrush-videos-footer">
        <a href="{{ section.settings.cta_link | default: '#comprar' }}" class="purebrush-btn-primary">
          <span>{{ section.settings.cta_text }}</span>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    {% endif %}
  </div>
</section>

<!-- Video Lightbox Modal Responsive (adaptable a vertical 9:16 y horizontal) -->
<div id="purebrush-video-modal" class="purebrush-video-modal" onclick="purebrushHandleBackdropClick(event)">
  <div id="purebrush-modal-inner" class="modal-inner">
    <div class="modal-header">
      <h4 id="modal-video-title" class="modal-title">Demostración</h4>
      <button type="button" class="modal-close-btn" onclick="purebrushCloseVideo()" aria-label="Cerrar vídeo">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </div>
    
    <div id="purebrush-modal-video-box" class="modal-video-container aspect-16-9">
      <iframe 
        id="purebrush-video-iframe" 
        src="" 
        title="Pure Brush Vídeo" 
        frameborder="0" 
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
        allowfullscreen
      ></iframe>
      <video id="purebrush-video-native-player" controls playsinline style="display:none; width:100%; height:100%; object-fit:contain;"></video>
    </div>

    <div class="modal-footer">
      <a href="#comprar" class="purebrush-btn-primary modal-cta-btn" onclick="purebrushCloseVideo()">
        <span>QUIERO PROBARLO AHORA - 17,90 €</span>
      </a>
    </div>
  </div>
</div>

<style>
.purebrush-videos-section {
  padding: 80px 20px;
}
.purebrush-videos-container {
  max-width: 1200px;
  margin: 0 auto;
}
.purebrush-videos-header {
  text-align: center;
  max-width: 720px;
  margin: 0 auto 50px auto;
}
.purebrush-video-grid {
  display: flex;
  justify-content: center;
  align-items: stretch;
  gap: 30px;
  flex-wrap: wrap;
}
.purebrush-video-card {
  background: #ffffff;
  border-radius: 24px;
  border: 1px solid #f0f0f0;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: transform 0.25s ease, box-shadow 0.25s ease;
  width: 100%;
  max-width: 440px;
}
.purebrush-video-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 14px 30px rgba(0, 0, 0, 0.08);
}
.video-thumbnail-wrapper {
  position: relative;
  width: 100%;
  background: #111827;
  overflow: hidden;
  cursor: pointer;
}
.video-thumbnail-wrapper.aspect-vertical {
  aspect-ratio: 9 / 14;
}
.video-thumbnail-wrapper.aspect-standard {
  aspect-ratio: 16 / 11;
}
.video-thumbnail-img,
.video-preview-native {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.35s ease;
  display: block;
}
.purebrush-video-card:hover .video-thumbnail-img,
.purebrush-video-card:hover .video-preview-native {
  transform: scale(1.04);
}
.video-placeholder-gradient {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #1f2937, #111827);
}
.video-card-overlay {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.25s ease;
}
.purebrush-video-card:hover .video-card-overlay {
  background: rgba(0, 0, 0, 0.15);
}
.play-pulse-btn {
  width: 58px;
  height: 58px;
  border-radius: 50%;
  background: #ffffff;
  color: #e11d48;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.3);
  transition: transform 0.25s ease, background 0.25s ease, color 0.25s ease;
}
.play-pulse-btn svg {
  margin-left: 3px;
}
.purebrush-video-card:hover .play-pulse-btn {
  transform: scale(1.1);
  background: #e11d48;
  color: #ffffff;
}
.video-tag {
  position: absolute;
  top: 14px;
  left: 14px;
  background: rgba(17, 24, 39, 0.85);
  color: #ffffff;
  font-size: 0.72rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  padding: 5px 10px;
  border-radius: 8px;
  backdrop-filter: blur(4px);
}
.video-duration {
  position: absolute;
  bottom: 14px;
  right: 14px;
  background: rgba(0, 0, 0, 0.75);
  color: #ffffff;
  font-size: 0.75rem;
  font-weight: 600;
  padding: 4px 8px;
  border-radius: 6px;
  display: inline-flex;
  align-items: center;
  gap: 5px;
  backdrop-filter: blur(4px);
}
.video-card-info {
  padding: 24px;
  display: flex;
  flex-direction: column;
  flex-grow: 1;
}
.video-card-title {
  font-size: 1.15rem;
  font-weight: 700;
  color: #111827;
  margin: 0 0 8px 0;
  line-height: 1.35;
}
.video-card-caption {
  font-size: 0.9rem;
  color: #6b7280;
  line-height: 1.5;
  margin: 0 0 18px 0;
  flex-grow: 1;
}
.video-text-link {
  background: none;
  border: none;
  padding: 0;
  color: #e11d48;
  font-size: 0.9rem;
  font-weight: 700;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  cursor: pointer;
  align-self: flex-start;
  transition: gap 0.2s ease;
}
.video-text-link:hover {
  gap: 10px;
}
.purebrush-videos-footer {
  text-align: center;
  margin-top: 50px;
}

/* Modal Lightbox */
.purebrush-video-modal {
  display: none;
  position: fixed;
  inset: 0;
  z-index: 999999;
  background: rgba(0, 0, 0, 0.88);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  padding: 20px;
  align-items: center;
  justify-content: center;
}
.purebrush-video-modal.is-open {
  display: flex;
}
.modal-inner {
  background: #111827;
  border-radius: 20px;
  width: 100%;
  max-width: 860px;
  box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
  overflow: hidden;
  animation: modalFadeIn 0.25s ease-out;
  transition: max-width 0.3s ease;
}
.modal-inner.is-vertical-modal {
  max-width: 440px;
}
@keyframes modalFadeIn {
  from {
    opacity: 0;
    transform: scale(0.95);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}
.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 24px;
  border-bottom: 1px solid #1f2937;
}
.modal-title {
  color: #ffffff;
  font-size: 1.05rem;
  font-weight: 600;
  margin: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  padding-right: 16px;
}
.modal-close-btn {
  background: transparent;
  border: none;
  color: #9ca3af;
  cursor: pointer;
  padding: 6px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: color 0.2s ease, background 0.2s ease;
}
.modal-close-btn:hover {
  color: #ffffff;
  background: #1f2937;
}
.modal-video-container {
  position: relative;
  width: 100%;
  background: #000000;
}
.modal-video-container.aspect-16-9 {
  padding-bottom: 56.25%;
}
.modal-video-container.aspect-9-16 {
  padding-bottom: 160%;
  max-height: 75vh;
}
.modal-video-container iframe {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}
.modal-footer {
  padding: 16px 24px;
  display: flex;
  justify-content: center;
  background: #111827;
  border-top: 1px solid #1f2937;
}
.modal-cta-btn {
  width: 100%;
  max-width: 380px;
  font-size: 0.95rem;
  padding: 14px 24px;
}

@media (max-width: 990px) {
  .purebrush-video-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}
@media (max-width: 640px) {
  .purebrush-videos-section {
    padding: 50px 16px;
  }
  .purebrush-video-grid {
    grid-template-columns: 1fr;
    gap: 20px;
  }
  .modal-inner {
    border-radius: 14px;
  }
}
</style>

<script>
function purebrushLaunchVideo(data) {
  var modal = document.getElementById('purebrush-video-modal');
  var modalInner = document.getElementById('purebrush-modal-inner');
  var box = document.getElementById('purebrush-modal-video-box');
  var iframe = document.getElementById('purebrush-video-iframe');
  var nativeVideo = document.getElementById('purebrush-video-native-player');
  var titleEl = document.getElementById('modal-video-title');

  if (titleEl) {
    titleEl.textContent = data.title || 'Demostración de Pure Brush';
  }

  // Configurar aspecto según orientación (vertical para shorts/reels)
  if (data.isShort) {
    modalInner.classList.add('is-vertical-modal');
    box.className = 'modal-video-container aspect-9-16';
  } else {
    modalInner.classList.remove('is-vertical-modal');
    box.className = 'modal-video-container aspect-16-9';
  }

  if (data.isMp4 && data.mp4Url) {
    if (iframe) iframe.style.display = 'none';
    if (nativeVideo) {
      nativeVideo.style.display = 'block';
      nativeVideo.src = data.mp4Url;
      nativeVideo.play();
    }
  } else if (data.ytId) {
    if (nativeVideo) {
      nativeVideo.pause();
      nativeVideo.style.display = 'none';
    }
    if (iframe) {
      iframe.style.display = 'block';
      iframe.src = 'https://www.youtube.com/embed/' + data.ytId + '?autoplay=1&rel=0&modestbranding=1&cc_load_policy=1&cc_lang_pref=es&hl=es';
    }
  }

  if (modal) {
    modal.classList.add('is-open');
    document.body.style.overflow = 'hidden';
  }
}

function purebrushCloseVideo() {
  var modal = document.getElementById('purebrush-video-modal');
  var iframe = document.getElementById('purebrush-video-iframe');
  var nativeVideo = document.getElementById('purebrush-video-native-player');

  if (iframe) {
    iframe.src = '';
  }
  if (nativeVideo) {
    nativeVideo.pause();
    nativeVideo.src = '';
  }

  if (modal) {
    modal.classList.remove('is-open');
    document.body.style.overflow = '';
  }
}

function purebrushHandleBackdropClick(event) {
  if (event.target && event.target.id === 'purebrush-video-modal') {
    purebrushCloseVideo();
  }
}

document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') {
    purebrushCloseVideo();
  }
});
</script>

